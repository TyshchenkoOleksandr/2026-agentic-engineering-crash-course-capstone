{
  "name": "capstone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm typecheck && pnpm lint && pnpm tests:locked && pnpm test",
    "tests:locked": "node scripts/tests-locked.mjs",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "test:e2e:ui": "playwright test --ui",
    "agent:log": "node scripts/agent-log-summary.mjs",
    "hooks:selftest": "node scripts/hooks-selftest.mjs",
    "skills:sync": "node scripts/skills-sync.mjs",
    "agent:loop": "node scripts/agent-loop.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.15.0"
}
